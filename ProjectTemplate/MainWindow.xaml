<Window x:Class="ProjectTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ProjectTemplate"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <materialDesign:Card Grid.Row="0"
                     Grid.Column="0"
                     Grid.ColumnSpan="3"
                     Background="{DynamicResource MaterialDesign.Brush.Primary.Light}">
                            <TextBlock x:Name="UpperBarTxt"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Text="Develop by Calvin"
                               Foreground="Black"
                               FontSize="20"/>
            </materialDesign:Card>
            <materialDesign:Card  Grid.Row="0"  Grid.Column="1"  Background="Transparent">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding AppName}" Foreground="White" FontSize="40"/>
            </materialDesign:Card>
            <Border Grid.Row="0" Grid.Column="2" Margin="5">
                <materialDesign:PopupBox x:Name="MenuPopupbox"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Padding="0"
                         StaysOpen="True">

                    <!-- 自訂這個 PopupBox 內部用到的樣式 -->
                    <materialDesign:PopupBox.Resources>
                        <!-- 左側圖示 + 文字 的輕量「選單按鈕」 -->
                        <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                        </Style>

                        <!-- Expander 標頭風格 -->
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4,0,0"/>
                        </Style>
                    </materialDesign:PopupBox.Resources>

                    <!-- 觸發區 -->
                    <materialDesign:PopupBox.ToggleContent>
                        <Border Padding="10,6" CornerRadius="10" Background="{DynamicResource MaterialDesignPaper}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="Menu" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </materialDesign:PopupBox.ToggleContent>

                    <!-- 內容：用 Card 當背景 + 留白 -->
                    <materialDesign:PopupBox.PopupContent>
                        <materialDesign:Card Padding="12"
                             Background="{DynamicResource MaterialDesignPaper}"
                             materialDesign:ColorZoneAssist.Mode="PrimaryMid"
                             MinWidth="220">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- 語言 Expander -->
                                    <materialDesign:PackIcon Kind="Earth" Width="22" Height="22" VerticalAlignment="Top" Margin="0,18,0,0"/>
                                    <Expander Header="Language" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"  IsExpanded="False">
                                        <StackPanel>
                                            <Button Style="{StaticResource MenuItemButton}"
                                                    Command="{Binding Change2Eng}"
                                                    CommandParameter="en"
                                                    Click="MenuPopupboxClose_Click"
                                                    Height="40">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="AlphabeticalVariant" Width="50" Height="25" Opacity="0.8"/>
                                                    <TextBlock Text="English" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource MenuItemButton}"
                                                    Command="{Binding Change2Chin}"
                                                    CommandParameter="zh-TW"
                                                    Click="MenuPopupboxClose_Click"
                                                    Height="40">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="IdeogramCjkVariant" Width="50" Height="25" Opacity="0.8"/>
                                                    <TextBlock Text="中文" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Expander>

                                </StackPanel>
                                <Separator Margin="0,6"/>

                                <!-- Engineer Mode -->
                                <Button Style="{StaticResource MenuItemButton}"
                                        Command="{Binding EngineerOnOff}"
                                        Click="MenuPopupboxClose_Click"
                                        Height="40">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountCog" Width="36" Height="18" Opacity="0.8"/>
                                        <TextBlock Text="Engineer Mode" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>
                    </materialDesign:PopupBox.PopupContent>
                </materialDesign:PopupBox>
            </Border>
            <StackPanel Grid.Row="1"  Grid.Column="0">
                <Button
                    Width="150"
                    Height="50"
                    Command="{Binding Func1Button}"
                    Content="{Binding Func1Name}"
                    Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                    ToolTip="MaterialDesignFlatDarkButton"
                    Margin="5"
                    />

                <Button
                    Width="150"
                    Height="50"
                    Command="{Binding Func2Button}"
                    Content="{Binding Func2Name}"
                    Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                    ToolTip="MaterialDesignFlatDarkButton"
                    Margin="5"
                    />

                <Button
                    Width="150"
                    Height="50"
                    Command="{Binding SetUpButton}"
                    Content="{Binding SetUpName}"
                    Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                    ToolTip="MaterialDesignFlatDarkButton"
                    Margin="5"
                    />
            </StackPanel>
            <Border x:Name="MainUI" Grid.Row="1"  Grid.Column="1" Grid.ColumnSpan="2" Margin="5" CornerRadius="5" Background="AliceBlue">
                
                
            </Border>
        </Grid>
        
    </Grid>
</Window>
